# Copy to .env for local use and replace every placeholder before starting.
# Generate values with a password manager or a cryptographically secure tool.
POSTGRES_DB=securelogpath
POSTGRES_USER=securelogpath
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local browser port for the frontend and same-origin /api proxy.
FRONTEND_PORT=8080

JWT_SIGNING_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
