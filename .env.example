# Copy to .env for local use and replace both values before starting.
# Generate values with a password manager or a cryptographically secure tool.
POSTGRES_DB=securelogpath
POSTGRES_USER=securelogpath
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local browser port for the frontend and same-origin /api proxy.
FRONTEND_PORT=8080

# Reserved for later phases. Never commit real values.
JWT_SIGNING_SECRET=replace-with-a-different-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-use
