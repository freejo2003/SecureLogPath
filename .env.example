# Copy to .env for local use. Replace secret placeholders before starting;
# replace PUBLIC_DOMAIN before enabling the public profile.
# Generate values with a password manager or a cryptographically secure tool.
POSTGRES_DB=securelogpath
POSTGRES_USER=securelogpath
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local browser port for the frontend and same-origin /api proxy.
FRONTEND_PORT=8080

# Optional public Compose profile: set this to a DNS name pointing at your host.
PUBLIC_DOMAIN=demo.example.org

JWT_SIGNING_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# RSA-2048 private key must exist at ./secrets/ingestion_private_key.pem.
# It is mounted read-only into the backend and must never be committed or baked into an image.
INGESTION_KEY_ID=siem-key-2026-01
MAX_UPLOAD_BYTES=2097152
MAX_UPLOAD_LINES=5000
MAX_CONCURRENT_INGESTIONS=2
